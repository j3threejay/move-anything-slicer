{
  "title": "Sample Slicer",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Transient-detection",
        "sample slicer with",
        "automatic tempo sync.",
        "",
        "Samples are detected",
        "and time-stretched to",
        "the Move's tempo."
      ]
    },
    {
      "title": "Quick Start",
      "lines": [
        "1. Browse & select",
        "   a sample",
        "2. Adjust threshold",
        "   with jog wheel",
        "3. Click jog to scan",
        "4. Hit pads to play",
        "   slices",
        "",
        "BPM is detected on",
        "load - no setup."
      ]
    },
    {
      "title": "Controls",
      "children": [
        {
          "title": "Knobs 1-4 (Bank A)",
          "lines": [
            "Per-Pad [P] default:",
            " K1: Attack",
            " K2: Decay",
            " K3: Start trim",
            " K4: End trim",
            "",
            "Global [G] mode:",
            " K1: Attack (all)",
            " K2: Decay (all)",
            " K3: Mono mode",
            "",
            "Sync [S] page:",
            " K1: Tempo sync",
            " K2: BPM correction",
            " K3: Slice mode",
            " K4: Slice count"
          ]
        },
        {
          "title": "Knobs 5-8 (Bank B)",
          "lines": [
            "Per-Pad [P] default:",
            " K5: Mode (gate/trig)",
            " K6: Pitch offset",
            " K7: Pad gain (mult)",
            " K8: Loop mode",
            "",
            "Global [G] mode:",
            " K5: Mode (gate/trig)",
            " K6: Pitch (+/-24st)",
            " K7: Gain (global)",
            " K8: Loop mode",
            "",
            "Sync [S] page:",
            " K5: Playthrough",
            " K6: Re-roll slices"
          ]
        },
        {
          "title": "Jog Wheel",
          "lines": [
            "Browser: scroll list",
            "Main: adjust thresh",
            "Click: scan/select",
            "",
            "Ready: click cycles",
            " [P] Per-Pad ->",
            " [G] Global ->",
            " [S] Sync",
            "",
            "Double-click jog to",
            "return to file browser",
            "and load a new sample."
          ]
        },
        {
          "title": "Knob Touch",
          "lines": [
            "Touch knobs 1-4 to",
            "show Bank A display.",
            "Touch knobs 5-8 to",
            "show Bank B display.",
            "",
            "Display persists",
            "across pad presses."
          ]
        },
        {
          "title": "Sync Page [S]",
          "lines": [
            "Sample BPM is found",
            "automatically and the",
            "sample is stretched",
            "to the Move's tempo.",
            "",
            "Smp: detected BPM",
            "Set: Move's tempo",
            "src: where the tempo",
            " came from -",
            " CLK live MIDI clock",
            " SET current Set",
            " CFG settings file",
            " DEF fallback 120",
            "",
            "K2 corrects the rare",
            "wrong reading:",
            " /2 2/3 x1 3/2 x2",
            "A loop with straight",
            "8ths can read double."
          ]
        },
        {
          "title": "Slice Modes",
          "lines": [
            "Transient: slices are",
            " placed on detected",
            " hits (jog sets how",
            " many survive).",
            "",
            "Random: slice points",
            " are scattered over",
            " the sample, snapped",
            " to a 16th grid at",
            " the detected BPM.",
            " K6 re-rolls them.",
            "",
            "Random turns on",
            "Playthrough, so a",
            "held pad keeps",
            "playing past the",
            "next slice point."
          ]
        }
      ]
    },
    {
      "title": "MIDI Mapping",
      "lines": [
        "Pads (68-99):",
        " Slices 0-31 direct",
        "",
        "Keyboard (C2 root):",
        " Note 36+ chromatic",
        " Up to 91 slices"
      ]
    },
    {
      "title": "Modes",
      "lines": [
        "Gate: plays while",
        " pad held, decay",
        " on release",
        "",
        "Trigger: plays full",
        " slice regardless",
        " of pad hold time",
        "",
        "Loop: forward, ping-",
        " pong or reverse",
        " within slice bounds",
        "",
        "Playthrough: ignores",
        " the slice end - runs",
        " on while held"
      ]
    }
  ]
}